{
  "name": "@drugstoresushi/phileas",
  "version": "0.0.0",
  "private": true,
  "description": "An exploratory testing engine for Electron apps: unscripted travel with continuous invariant checking.",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "phileas": "./bin/phileas.mjs"
  },
  "files": [
    "src",
    "bin"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && playwright test",
    "journey": "node bin/phileas.mjs run proving-ground/buggy/phileas",
    "demo:train": "node demo/rail-itinerary/watch.mjs",
    "demo:train:present": "node demo/rail-itinerary/present.mjs",
    "demo:eighty-days": "node demo/eighty-days/watch.mjs",
    "demo:eighty-days:present": "node demo/eighty-days/present.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@electron/asar": "^4.3.0"
  },
  "peerDependencies": {
    "@playwright/test": "~1.63.0",
    "electron": ">=43 <45"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "electron": "^44.4.3",
    "typescript": "^7.0.2"
  },
  "author": "Drugstore Sushi"
}
