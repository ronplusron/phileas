{
  "name": "@drugstoresushi/phileas",
  "version": "0.5.2",
  "private": true,
  "description": "An exploratory testing engine for Electron apps: unscripted travel with continuous invariant checking.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "phileas": "./bin/phileas.mjs"
  },
  "files": [
    "dist",
    "bin",
    "src/**/*.mjs"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && tsc --noEmit && playwright test",
    "journey": "npm run build && node bin/phileas.mjs run proving-ground/buggy/phileas",
    "demo:train": "npm run build && node demo/rail-itinerary/watch.mjs",
    "demo:train:present": "npm run build && node demo/rail-itinerary/present.mjs",
    "demo:eighty-days": "npm run build && node demo/eighty-days/watch.mjs",
    "demo:eighty-days:present": "npm run build && node demo/eighty-days/present.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@electron/asar": "^4.3.0"
  },
  "peerDependencies": {
    "@playwright/test": "~1.63.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "electron": "^44.4.3",
    "typescript": "^7.0.2"
  },
  "author": "Drugstore Sushi"
}
