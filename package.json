{
  "name": "@drugstoresushi/phileas",
  "version": "0.0.0",
  "private": true,
  "description": "An exploratory testing engine for Electron apps: unscripted traversal with continuous invariant checking.",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "phileas": "./bin/phileas.mjs"
  },
  "files": [
    "src",
    "bin"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "journey": "node bin/phileas.mjs run testbed/buggy/phileas",
    "demo:train": "node demo/rail-itinerary/watch.mjs",
    "demo:present": "node demo/rail-itinerary/present.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@electron/asar": "^4.3.0"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.63.0",
    "electron": ">=43"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "electron": "^44.4.3",
    "typescript": "^7.0.2"
  },
  "author": "Drugstore Sushi"
}
